# reolink-timelapse -- Raspberry Pi 5 image WITH hardware HEVC decode.
#
# Same app as the generic Dockerfile, but built on Raspberry Pi OS's apt
# repository so the ffmpeg inside carries Raspberry Pi's v4l2-request
# patches -- the only ffmpeg that can drive the Pi 5's rpivid HEVC block
# (`-hwaccel drm`, see decode.py). A generic image would silently fall
# back to software decode and run the Pi flat-out. Build ON the Pi
# (arm64) and give the container the decode devices (docker-compose.yml's
# "pi" profile does this): /dev/video19, /dev/media0 (the media-controller
# node ffmpeg locates the decoder through -- measured 2026-09-04: without
# it hwaccel silently falls back to software), /dev/dri and /dev/dma_heap.
# Verified unprivileged as uid 1000: 0.27s CPU vs 10.0s software per 10s of
# 4K footage inside the container.
#
#   docker build -f Dockerfile.pi -t reolink-timelapse:pi .
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && curl -fsSL https://archive.raspberrypi.com/debian/raspberrypi.gpg.key \
      | gpg --dearmor -o /usr/share/keyrings/raspberrypi-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/raspberrypi-archive-keyring.gpg] http://archive.raspberrypi.com/debian/ bookworm main" \
      > /etc/apt/sources.list.d/raspi.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg tzdata python3 python3-venv \
 && apt-get purge -y curl gnupg && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY pyproject.toml README.md ./
COPY reolink_timelapse ./reolink_timelapse
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir . && rm -rf /src

ENV REOLINK_TIMELAPSE_HOME=/data \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"
# uid 1000 matches the default first user on Raspberry Pi OS so a bind-mounted
# /data on the host is readable both ways; 'video' and 'render' groups are
# what the decode device nodes are owned by on Pi OS.
RUN useradd --uid 1000 --create-home app \
 && (getent group video >/dev/null || groupadd --gid 44 video) \
 && (getent group render >/dev/null || groupadd --gid 105 render) \
 && usermod -aG video,render app \
 && mkdir -p /data && chown app:app /data
USER app
WORKDIR /data
VOLUME ["/data"]
EXPOSE 8177

ENTRYPOINT ["reolink-timelapse"]
CMD ["serve-stream"]
