[Unit]
Description=reolink-timelapse live-view web server (Watch in VLC etc.)
After=network-online.target
Wants=network-online.target

[Service]
# Without this, Python block-buffers stdout under systemd (no tty) and
# the app's log lines never reach the journal in any useful timeframe.
Environment=PYTHONUNBUFFERED=1
Type=simple
WorkingDirectory=__REPO_DIR__
ExecStart=__VENV_BIN__/reolink-timelapse serve-stream
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
